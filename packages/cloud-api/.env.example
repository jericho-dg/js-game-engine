# Storage backend: "file" (local .cloud-data) or "supabase"
CLOUD_STORE=file

# File backend (default for local dev)
# CLOUD_DATA_DIR=../../.cloud-data

# Supabase backend (hosted production)
# CLOUD_STORE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# With Supabase backend, auth is handled by Supabase Auth in the editor
# (VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY). Run migration 002 after 001.

# HTTP port (default 8787)
# PORT=8787
