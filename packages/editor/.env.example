# Local dev: proxy to cloud API on port 8787 (run `npm run dev:cloud-api`)
# VITE_CLOUD_API_URL=/cloud-api

# Production (Vercel): full Railway URL including https:// — no trailing slash
# VITE_CLOUD_API_URL=https://your-service.up.railway.app

# Production auth (Supabase). Required when the cloud API uses CLOUD_STORE=supabase.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
