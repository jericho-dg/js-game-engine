# Optional: use the local cloud API dev server instead of simulated IndexedDB sync.
# Start the API with `npm run dev:cloud-api` from the repo root, then uncomment:
# VITE_CLOUD_API_URL=/cloud-api

# Production auth (Supabase). Required when the cloud API uses CLOUD_STORE=supabase.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
