{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "packages/editor/dist",
  "rewrites": [
    {
      "source": "/cloud-api/:path*",
      "destination": "https://js-game-enginecloud-api-production.up.railway.app/:path*"
    },
    {
      "source": "/play/:path*",
      "destination": "https://js-game-enginecloud-api-production.up.railway.app/play/:path*"
    }
  ]
}
